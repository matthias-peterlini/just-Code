{
  "name": "@justapps/just-code",
  "version": "0.2.1",
  "description": "just-Code \u2014 terminal AI IDE: an orchestrator model that delegates to parallel sub-agents (Gemini, Groq, OpenRouter, any OpenAI-compatible API).",
  "type": "module",
  "bin": {
    "just-code": "dist/cli.js",
    "jc": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p . --noEmit",
    "prepack": "npm run build",
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matthias-peterlini/just-Code.git"
  },
  "homepage": "https://code.justapps.it",
  "keywords": [
    "ai",
    "cli",
    "agents",
    "gemini",
    "groq",
    "openrouter",
    "terminal",
    "ide"
  ],
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
